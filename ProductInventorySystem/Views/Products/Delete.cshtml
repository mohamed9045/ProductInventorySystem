@model ProductInventorySystem.BLL.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">

    <h2 class="mb-4 text-danger">Delete Product</h2>

    <div class="card border-danger shadow-sm">

        <div class="card-header bg-danger text-white">
            Confirm Product Deletion
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this product?
            </div>

            <dl class="row">

                <dt class="col-sm-3">Product ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">SKU</dt>
                <dd class="col-sm-9">@Model.SKU</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.Price</dd>

                <dt class="col-sm-3">Stock Quantity</dt>
                <dd class="col-sm-9">@Model.StockQuantity</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category</dd>

            </dl>

            <form asp-action="DeleteConfirmed" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
