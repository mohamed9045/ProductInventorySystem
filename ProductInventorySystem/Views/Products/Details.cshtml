@model ProductInventorySystem.BLL.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <h2 class="mb-4">Product Details</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Product Information
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Product ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">SKU</dt>
                <dd class="col-sm-9">@Model.SKU</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.Price</dd>

                <dt class="col-sm-3">Stock Quantity</dt>
                <dd class="col-sm-9">@Model.StockQuantity</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category</dd>

                <dt class="col-sm-3">Expiry Date</dt>
                <dd class="col-sm-9">
                    @(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "Not specified")
                </dd>

            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Product
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Products
            </a>

        </div>
    </div>

</div>
